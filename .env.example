# AgentCost Dashboard - Environment Variables

# URL of your AgentCost backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# GOOGLE OAUTH
# Same Client ID used in the backend - enables "Continue with Google" button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GITHUB OAUTH
# OAuth App Client ID (secret lives in the backend) - enables "Continue with GitHub"
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-oauth-app-client-id

# MICROSOFT CLARITY (optional)
# Session recordings - create a project at https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# OPTIONAL SETTINGS
# Enable debug mode
NEXT_PUBLIC_DEBUG=false
